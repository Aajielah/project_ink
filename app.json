{
  "expo": {
    "name": "Daily Notes",
    "slug": "daily_notes",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dailynotes.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
